@inject AppSession Session
@inject LeaveRepository Repository
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IDisposable

<div class="app-shell">
    <aside class="app-sidebar">
        <SidebarBrand />
        <div class="sb-meta"><span class="sb-meta-dot"></span><span class="nav-label">Kho lưu trữ Phòng QLHV</span></div>
        <nav class="sb-nav">
            <div class="sb-caption">Chức năng</div>
            <button type="button" class="sb-link @(phongTab == "records" ? "active" : "")" @onclick='() => SwitchTab("records")'>
                <Icon Name="archive" /><span class="nav-label">Lưu trữ &amp; tra cứu nghỉ phép</span>
            </button>
            <button type="button" class="sb-link @(phongTab == "pending" ? "active" : "")" @onclick='() => SwitchTab("pending")'>
                <Icon Name="clock" /><span class="nav-label">Đơn chờ duyệt</span>
            </button>
            <button type="button" class="sb-link @(phongTab == "stats" ? "active" : "")" @onclick='() => SwitchTab("stats")'>
                <Icon Name="chart" /><span class="nav-label">Thống kê</span>
            </button>
            <div class="sb-caption">Danh mục</div>
            <button type="button" class="sb-link @(phongTab is "classes" or "add-class" ? "active" : "")" @onclick='() => SwitchTab("classes")'>
                <Icon Name="users" /><span class="nav-label">Danh sách các lớp &amp; học viên</span>
            </button>
            <button type="button" class="sb-link @(phongTab == "catalog" ? "active" : "")" @onclick='() => SwitchTab("catalog")'>
                <Icon Name="list" /><span class="nav-label">Danh mục lễ/Tết &amp; trung đội</span>
            </button>
        </nav>
    </aside>

    <div class="app-workspace">
        <header class="app-topbar">
            <button type="button" class="nav-toggle" title="Thu gọn / mở rộng menu" aria-label="Thu gọn hoặc mở rộng menu" onclick="leaveApp.toggleNav()"><Icon Name="sidebar" /></button>
            <div class="app-crumbs">
                Phòng Quản lý học viên <b>/</b> <span>@(phongTab == "records" ? "Lưu trữ & tra cứu nghỉ phép" : phongTab == "pending" ? "Đơn chờ Phòng QLHV duyệt" : phongTab == "stats" ? "Thống kê" : phongTab == "catalog" ? "Danh mục" : phongTab == "add-class" ? "Thiết lập danh sách lớp mới" : "Quản lý danh sách các lớp & Học viên")</span>
            </div>
            <div class="top-actions"><TopbarDate /><span class="top-sep"></span><AccountMenu /></div>
        </header>

        <main class="content">

            @if (phongTab == "records")
            {
                <QuanLyDonNghiPhep AllRecords="@AllRecords"
                                   Classes="@Classes" OnExport="ExportFiltered" OnChanged="@OnDataChanged" />
            }
            else if (phongTab == "pending")
            {
                <section class="panel list-panel">
                    <div class="panel-head"><h2>Đơn chờ duyệt (@Pending.Count)</h2></div>
                    <div style="padding:14px 18px; display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end; border-bottom:1px solid #e5ece7;">
                        <div class="field" style="min-width:240px; margin:0;">
                            <label>Chọn lớp</label>
                            <select @bind="pendingClass">
                                <option value="">-- Chọn lớp --</option>
                                @foreach (var c in PendingClasses)
                                {
                                    <option value="@c.Lop">@c.Lop (@c.Count đơn chờ)</option>
                                }
                            </select>
                        </div>
                        @if (!string.IsNullOrEmpty(pendingClass))
                        {
                            <div class="row-actions">
                                <button class="btn @(pendingKind == LeaveCategories.TranhThu ? "primary" : "outline")" @onclick="() => pendingKind = LeaveCategories.TranhThu">Tranh thủ (@CountKind(LeaveCategories.TranhThu))</button>
                                <button class="btn @(pendingKind == LeaveCategories.CuoiTuan ? "primary" : "outline")" @onclick="() => pendingKind = LeaveCategories.CuoiTuan">Cuối tuần (@CountKind(LeaveCategories.CuoiTuan))</button>
                                <button class="btn @(pendingKind == LeaveCategories.LeTet ? "primary" : "outline")" @onclick="() => pendingKind = LeaveCategories.LeTet">Lễ / Tết (@CountKind(LeaveCategories.LeTet))</button>
                            </div>
                        }
                    </div>
                    @if (string.IsNullOrEmpty(pendingClass))
                    {
                        <div class="empty-table" style="padding:24px;">Hãy chọn một lớp để xem và duyệt đơn.</div>
                    }
                    else
                    {
                        <LeaveDataTable @key="(pendingClass + pendingKind)" Items="@PendingView" OnChanged="@OnDataChanged" ShowExport="false">
                            <Toolbar>
                                @if (pendingKind != LeaveCategories.TranhThu && PendingView.Count > 0)
                                {
                                    <button class="btn primary" @onclick="ApproveAllCurrent">Duyệt tất cả (@PendingView.Count)</button>
                                }
                            </Toolbar>
                        </LeaveDataTable>
                    }
                </section>
            }
            else if (phongTab == "stats")
            {
                <ThongKe Records="@AllRecords" />
            }
            else if (phongTab == "catalog")
            {
                <DanhMuc />
            }
          
            else
            {
                <QuanLyDanhSachLop ClassGroups="@ClassGroups"
                                   AllStudents="@AllStudents"
                                   AllRecords="@AllRecords"
                                   OnOpenCreateClass='() => SwitchTab("add-class")'
                                   OnDataChanged="@OnDataChanged"
                                   OnNotice="@OnNotice"
                                   OnError="@OnError" />
                @if (phongTab == "add-class")
                {
                    <div class="overlay"><div class="modal-box xl" @onclick:stopPropagation="true">
                        <TaoDanhSachLopMoi OnBack='() => SwitchTab("classes")'
                                   OnClassCreated="HandleClassCreated"
                                   OnNotice="@OnNotice"
                                   OnError="@OnError" />
                    </div></div>
                }
            }
        </main>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<ClassGroup> ClassGroups { get; set; } = new();
    [Parameter, EditorRequired] public List<Student> AllStudents { get; set; } = new();
    [Parameter, EditorRequired] public List<LeaveRequest> AllRecords { get; set; } = new();
    [Parameter] public EventCallback OnDataChanged { get; set; }
    [Parameter] public EventCallback OnExportExcel { get; set; }
    [Parameter] public EventCallback<string> OnNotice { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private string phongTab = "records";
    private static readonly string[] Tabs = { "records", "pending", "stats", "classes", "catalog", "add-class" };
    protected override void OnInitialized()
    {
        if (TabFromUri(Navigation) is { } t && Tabs.Contains(t)) phongTab = t;
        Navigation.LocationChanged += OnLocation;
    }
    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var t = TabFromUri(Navigation) ?? "records";
        if (Tabs.Contains(t) && t != phongTab) { phongTab = t; _ = InvokeAsync(StateHasChanged); }
    }
    public void Dispose() => Navigation.LocationChanged -= OnLocation;
    // Liên kết cũ ?tab=import-class (trước khi gộp "Nhập từ Excel" vào "Tạo lớp mới") vẫn mở đúng màn tạo lớp
    private static string? TabFromUri(NavigationManager nav) => RawTabFromUri(nav) is "import-class" ? "add-class" : RawTabFromUri(nav);
    private static string? RawTabFromUri(NavigationManager nav)
    {
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(nav.Uri).Query);
        return q.TryGetValue("tab", out var v) ? v.ToString() : null;
    }


    private List<LeaveRequest> Pending => AllRecords.Where(x => x.TrangThai == LeaveStatuses.WaitingPhong).OrderBy(x => x.NgayTao).ToList();
    private string pendingClass = "";
    private string pendingKind = LeaveCategories.TranhThu;
    private List<(string Lop, int Count)> PendingClasses => Pending.GroupBy(x => x.Lop).OrderBy(g => g.Key).Select(g => (g.Key, g.Count())).ToList();
    private int CountKind(string kind) => Pending.Count(x => x.Lop == pendingClass && x.PhanLoaiNghi == kind);
    private List<LeaveRequest> PendingView => Pending.Where(x => x.Lop == pendingClass && x.PhanLoaiNghi == pendingKind).ToList();
    private async Task ApproveAllCurrent()
    {
        try
        {
            var n = Repository.ApproveAllPending(Session, pendingClass, pendingKind);
            await OnDataChanged.InvokeAsync();
            await OnNotice.InvokeAsync($"Đã duyệt {n} đơn của lớp {pendingClass}.");
        }
        catch (Exception ex) { await OnError.InvokeAsync(ValidationRules.ErrorMessage(ex)); }
    }
    private List<string> Classes => ClassGroups.Select(x => x.TenLop).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

    private async Task SwitchTab(string tab)
    {
        phongTab = tab;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tab", tab));
        await OnError.InvokeAsync("");
    }

    private async Task HandleClassCreated()
    {
        await OnDataChanged.InvokeAsync();
        phongTab = "classes";
    }
    private async Task ExportFiltered(List<LeaveRequest> rows)
    {
        try {var bytes=Repository.ExportExcel(Session,rows);await JS.InvokeVoidAsync("leaveApp.downloadBase64","DanhSachNghiPhep_DaLoc.xlsx",Convert.ToBase64String(bytes),"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");await OnNotice.InvokeAsync($"Đã xuất {rows.Count} bản ghi theo bộ lọc.");}
        catch(Exception ex) {await OnError.InvokeAsync(ex is UserAccessException or ArgumentException?ex.Message:"Không thể xuất dữ liệu.");}
    }
}
