@inject AppSession Session
@inject LeaveRepository Repository
@inject AdminService Accounts
@inject IJSRuntime JS
@inject NotifyService Notify

<div class="add-class-page">
    <div class="content" style="padding: 0;">
        <div class="panel-head" style="background: linear-gradient(135deg, #1b4d3e, #0d3326) !important; padding: 16px 24px !important; border-radius: 12px 12px 0 0 !important; display: flex; align-items: center; justify-content: space-between; border-bottom: none !important;">
            <h2 style="color: #ffffff !important; font-size: 19px !important; font-weight: 800 !important; margin: 0; letter-spacing: 0.5px; display: flex; align-items: center; gap: 8px;">
                <Icon Name="plus" /> Tạo lớp mới
            </h2>
            <button type="button" class="btn" style="background: rgba(255, 255, 255, 0.15) !important; color: #ffffff !important; border: 1px solid rgba(255, 255, 255, 0.4) !important;" @onclick="OnBack">
                Đóng
            </button>
        </div>

        <section class="panel form-panel" style="margin-bottom: 20px;">
            <div class="panel-head" style="background: #f8fafc !important; border-bottom: 1.5px solid #e2e8f0 !important; padding: 14px 24px !important;">
                <div>
                    <h2 style="color: #1b4d3e !important; font-size: 16px !important; font-weight: 800 !important; margin: 0; text-transform: uppercase; letter-spacing: 0.5px;">
                        📌 Thông tin lớp
                    </h2>
                </div>
            </div>
            <div class="form-body" style="padding: 20px 24px;">
                <!-- Hai ô thông tin lớp -->
                <div class="form-two">

                    <!-- Ô 1: Tên lớp mới -->
                    <div class="field" style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 13px; font-weight: 700; color: #1e3a29;">Tên lớp mới <span style="color: #dc2626;">*</span></label>
                        <input @bind="newClassName" @bind:event="oninput" placeholder="Ví dụ: B10D57"
                               style="width: 100%; height: 42px; padding: 0 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; outline: none; background: #ffffff;" />
                    </div>

                    <!-- Ô 2: Tài khoản Chủ nhiệm trung đội -->
                    <div class="field" style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 13px; font-weight: 700; color: #1e3a29;">Tài khoản Chủ nhiệm trung đội <span style="color: #dc2626;">*</span></label>
                        <select @bind="selectedManagerAccount"
                                style="width: 100%; height: 42px; padding: 0 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; outline: none; background: #ffffff;">
                            @if (trungDoiAccounts.Count == 0)
                            {
                                <option>trungdoi (Mặc định)</option>
                            }
                            else
                            {
                                @foreach (var acc in trungDoiAccounts)
                                {
                                    <option value="@acc">Tài khoản: @acc (Chủ nhiệm)</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </section>
        <section class="panel">
            <div class="panel-head">
                <div>
                    <h2>Danh sách học viên lớp @(string.IsNullOrWhiteSpace(newClassName) ? "(Chưa nhập tên lớp)" : newClassName)</h2>
                </div>
                <div class="heading-actions">
                    <button class="btn primary" @onclick="AskConfirmSaveNewClass"> Lưu lớp</button>
                </div>
            </div>
            <div class="table-toolbar draft-toolbar">
                <div class="row-actions">
                    <label class="btn outline file-btn" title="Chọn tệp .xlsx hoặc .csv">
                        <Icon Name="upload" />Nhập từ Excel
                        <InputFile @key="fileInputKey" OnChange="HandleExcelUpload" accept=".xlsx,.csv,.txt" />
                    </label>
                    <button type="button" class="btn outline" @onclick="AddEmptyDraftStudentRow"><Icon Name="plus" />Thêm dòng</button>
                    <button type="button" class="link-btn" @onclick="DownloadSampleClassExcel"><Icon Name="download" />Tải file mẫu</button>
                </div>
                <span class="toolbar-hint">Nhập từ Excel sẽ thay danh sách đang có; sau đó vẫn sửa hoặc thêm dòng trực tiếp trong bảng.</span>
            </div>

            @if (submitAttempted && validationErrors.Count > 0)
            {
                <div id="class-validation-box" class="alert error" role="alert" style="margin: 0 24px 14px;">
                    <div>Có @validationErrors.Count lỗi cú pháp, vui lòng sửa trước khi lưu:</div>
                    <ul style="margin: 8px 0 0 20px; font-weight: 500;">
                        @foreach (var msg in validationErrors)
                        {
                            <li>@msg</li>
                        }
                    </ul>
                </div>
            }

            <div class="table-scroll">
                <table class="leave-table editable-table">
                    <thead>
                        <tr>
                            <th style="width:80px">STT</th>
                            <th>TÊN HỌC VIÊN</th>
                            <th style="width:180px">LỚP</th>
                            <th style="width:200px">NGÀY SINH</th>
                            <th style="width:220px">SỐ ĐIỆN THOẠI</th>
                            <th style="width:110px">XÓA DÒNG</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (draftStudents.Count == 0)
                        {
                            <tr><td colspan="6" class="empty-table">Chưa có học viên. Bấm <b>Nhập từ Excel</b> để đọc danh sách từ tệp, hoặc <b>Thêm dòng</b> để nhập tay.</td></tr>
                        }
                        @{ var draftOffset = (Paging.Clamp(draftStudents.Count, draftPage, draftPageSize) - 1) * draftPageSize; }
                        @for (int i = draftOffset; i < Math.Min(draftOffset + draftPageSize, draftStudents.Count); i++)
                        {
                            int index = i;
                            var row = draftStudents[index];
                            row.STT = index + 1;
                            if (string.IsNullOrWhiteSpace(row.Lop) && !string.IsNullOrWhiteSpace(newClassName))
                            {
                                row.Lop = newClassName;
                            }
                            <tr>
                                <td><b>@row.STT</b></td>
                                <td>
                                    <input class="table-input" @bind="row.HoTen" placeholder="Nhập họ và tên học viên..." />
                                </td>
                                <td>
                                    <input class="table-input" value="@(string.IsNullOrWhiteSpace(newClassName) ? row.Lop : newClassName)"
                                           @onchange="e => { row.Lop = e.Value?.ToString() ?? string.Empty; if (string.IsNullOrWhiteSpace(newClassName)) newClassName = row.Lop; }"
                                           placeholder="VD: B10D57" />
                                </td>
                                <td>
                                    <input class="table-input @(IsBirthDateInvalid(row) ? "invalid" : "")" @bind="row.NgaySinh" @bind:event="oninput" placeholder="dd/MM/yyyy (VD: 01/01/2006)" />
                                </td>
                                <td>
                                    <input class="table-input @(IsPhoneInvalid(row) ? "invalid" : "")" @bind="row.SoDienThoai" @bind:event="oninput" placeholder="Số điện thoại (VD: 0912345678)" />
                                </td>
                                <td>
                                    <button type="button" class="btn small danger" @onclick="() => RemoveDraftStudentRow(index)">Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Total="draftStudents.Count" @bind-Page="draftPage" @bind-PageSize="draftPageSize" Label="dòng học viên" />

            <div class="form-footer" style="padding: 20px 24px;">
                <span>Tổng số dòng đã nhập họ tên: <b>@draftStudents.Count(x => !string.IsNullOrWhiteSpace(x.HoTen))</b> học viên · Tài khoản quản lý: <b>@selectedManagerAccount</b></span>
            </div>
        </section>
    </div>
</div>

@if (showConfirmNewClassModal)
{
    <div class="overlay" @onclick="() => showConfirmNewClassModal = false">
        <div class="modal confirm-modal" style="max-width: 620px;" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="warning-icon" style="background:#e3f5ec;color:#087447;"></div>
            <h2>Xác nhận tạo danh sách lớp @newClassName?</h2>
            <p>
                Bạn đang chuẩn bị lưu danh sách lớp <b>@newClassName</b> gồm <b>@draftStudents.Count(x => !string.IsNullOrWhiteSpace(x.HoTen)) học viên</b>.<br />Lớp này sẽ được phân công cho tài khoản Chủ nhiệm trung đội: <b>@selectedManagerAccount</b>.<br />Sau khi xác nhận, tài khoản <b>@selectedManagerAccount</b> khi đăng nhập sẽ thấy lớp <b>@newClassName</b> để tạo danh sách nghỉ phép.
            </p>
            <div class="modal-actions center">
                <button class="btn outline" @onclick="() => showConfirmNewClassModal = false"> Chỉnh sửa lại</button>
                <button class="btn primary" @onclick="ConfirmCreateNewClass"> Đúng, lưu thông tin lớp</button>
            </div>
        </div>
    </div>
}

@code {
    private int fileInputKey; // đổi key để chọn lại cùng một tệp vẫn kích hoạt OnChange
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback OnClassCreated { get; set; }
    [Parameter] public EventCallback<string> OnNotice { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private string newClassName = "";
    private string selectedManagerAccount = "trungdoi";
    private List<string> trungDoiAccounts = new();
    private List<Student> draftStudents = new();
    private int draftPage = 1, draftPageSize = Paging.DefaultSize;
    private bool showConfirmNewClassModal = false;
    private bool submitAttempted = false;
    private List<string> validationErrors => submitAttempted ? CollectValidationErrors() : new();

    protected override async Task OnInitializedAsync()
    {
        draftStudents = new List<Student>
        {
           
            
        };

        try
        {
            trungDoiAccounts = await Accounts.ListTrungDoiUsers(Session);
            if (trungDoiAccounts.Count > 0)
            {
                selectedManagerAccount = trungDoiAccounts[0];
            }
        }
        catch
        {
            trungDoiAccounts = new List<string> { "trungdoi" };
        }
    }

    private void AddEmptyDraftStudentRow()
    {
        draftPage = int.MaxValue; // nhảy tới trang cuối để thấy dòng vừa thêm
        draftStudents.Add(new Student
        {
            STT = draftStudents.Count + 1,
            HoTen = "",
            Lop = newClassName,
            NgaySinh = "",
            SoDienThoai = ""
        });
    }

    private async Task RemoveDraftStudentRow(int index)
    {
        if (index < 0 || index >= draftStudents.Count) return;
        var row = draftStudents[index];
        // Dòng trống xóa luôn; dòng đã nhập họ tên thì hỏi lại
        if (!string.IsNullOrWhiteSpace(row.HoTen)
            && !await Notify.ConfirmAsync("Xóa dòng học viên?", $"Dòng {index + 1} ({row.HoTen.Trim()}) sẽ bị xóa khỏi danh sách đang soạn."))
            return;
        if (index < draftStudents.Count && ReferenceEquals(draftStudents[index], row))
            draftStudents.RemoveAt(index);
        if (draftStudents.Count == 0)
            AddEmptyDraftStudentRow();
    }

    private async Task HandleExcelUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file is null) return;
            int filled = draftStudents.Count(x => !string.IsNullOrWhiteSpace(x.HoTen));
            if (filled > 0 && !await Notify.ConfirmAsync("Thay danh sách đang có?",
                    $"Bảng đang có {filled} học viên. Nhập tệp \"{file.Name}\" sẽ thay toàn bộ danh sách này.", "Thay danh sách"))
                return;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var imported = ClassListImporter.ParseClassExcel(ms, newClassName);
            if (imported.Count == 0)
            {
                await OnError.InvokeAsync("Không đọc được dòng học viên nào từ tệp đã chọn. Hãy kiểm tra các cột: STT; Tên; Lớp; Ngày sinh; Số điện thoại.");
                return;
            }

            // Mỗi lần chỉ nhập một lớp: tệp có nhiều lớp khác nhau thì dừng, tránh gộp nhầm vào cùng một lớp
            var fileClasses = imported.Select(x => x.Lop.Trim()).Where(x => x.Length > 0)
                                      .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (fileClasses.Count > 1)
            {
                await OnError.InvokeAsync($"Tệp \"{file.Name}\" chứa {fileClasses.Count} lớp khác nhau ({string.Join(", ", fileClasses.Take(5))}). Mỗi lần chỉ nhập danh sách của một lớp.");
                return;
            }

            draftStudents = imported;
            draftPage = 1;
            submitAttempted = false; // lỗi kiểm tra của danh sách cũ không còn áp dụng
            if (string.IsNullOrWhiteSpace(newClassName) && fileClasses.Count == 1)
                newClassName = fileClasses[0];

            await OnError.InvokeAsync("");
            await OnNotice.InvokeAsync($"Đã đọc thành công {imported.Count} học viên từ tệp \"{file.Name}\" lên giao diện. Bạn có thể kiểm tra và chỉnh sửa từng ô nếu cần trước khi lưu.");
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ValidationRules.ErrorMessage(ex));
        }
        finally
        {
            // Đọc xong (hoặc hủy) mới tạo lại ô chọn tệp, để chọn lại đúng tệp đó vẫn nhận được
            fileInputKey++;
        }
    }

    private async Task DownloadSampleClassExcel()
    {
        await JS.InvokeVoidAsync("open", "/filemau.xlsx", "_blank");
    }

    private static bool Fails(Action check)
    {
        try { check(); return false; }
        catch (ArgumentException) { return true; }
    }

    private bool IsBirthDateInvalid(Student row) =>
        submitAttempted && !string.IsNullOrWhiteSpace(row.HoTen) && Fails(() => ValidationRules.BirthDate(row.NgaySinh));

    private bool IsPhoneInvalid(Student row) =>
        submitAttempted && !string.IsNullOrWhiteSpace(row.HoTen) && Fails(() => ValidationRules.Phone(row.SoDienThoai));

    private List<string> CollectValidationErrors()
    {
        var errors = new List<string>();
        for (int i = 0; i < draftStudents.Count; i++)
        {
            var row = draftStudents[i];
            if (string.IsNullOrWhiteSpace(row.HoTen)) continue;
            string who = $"Dòng {i + 1} ({row.HoTen.Trim()})";
            try { ValidationRules.BirthDate(row.NgaySinh); }
            catch (ArgumentException ex) { errors.Add($"{who}: {ex.Message}"); }
            try { ValidationRules.Phone(row.SoDienThoai); }
            catch (ArgumentException ex) { errors.Add($"{who}: {ex.Message}"); }
        }
        return errors;
    }

    private async Task AskConfirmSaveNewClass()
    {
        await OnError.InvokeAsync("");
        if (string.IsNullOrWhiteSpace(newClassName))
        {
            await OnError.InvokeAsync("Vui lòng nhập tên lớp mới (ví dụ: B9D55).");
            return;
        }
        if (!draftStudents.Any(x => !string.IsNullOrWhiteSpace(x.HoTen)))
        {
            await OnError.InvokeAsync("Vui lòng nhập ít nhất 1 học viên trong danh sách lớp.");
            return;
        }

        submitAttempted = true;
        int errorCount = CollectValidationErrors().Count;
        if (errorCount > 0)
        {
            // Chuyển tới trang chứa dòng lỗi đầu tiên
            var firstBad = draftStudents.FindIndex(r => IsBirthDateInvalid(r) || IsPhoneInvalid(r));
            if (firstBad >= 0) draftPage = firstBad / draftPageSize + 1;
            await OnError.InvokeAsync($"Danh sách lớp còn {errorCount} lỗi ngày sinh hoặc số điện thoại. Xem chi tiết ở khung đỏ phía trên bảng học viên.");
            await JS.InvokeVoidAsync("leaveApp.scrollToId", "class-validation-box");
            return;
        }
        showConfirmNewClassModal = true;
    }

    private async Task ConfirmCreateNewClass()
    {
        try
        {
            // Bảng hiển thị "Tên lớp mới" cho mọi dòng, nên lưu đúng giá trị đó (không dùng lớp cũ đọc từ tệp)
            foreach (var row in draftStudents)
                row.Lop = newClassName.Trim();
            var created = Repository.CreateClassWithStudents(Session, newClassName, draftStudents, selectedManagerAccount);
            showConfirmNewClassModal = false;
            await OnNotice.InvokeAsync($"Đã tạo thành công danh sách lớp {created.TenLop} (giao tài khoản {created.NguoiTao} quản lý) và đồng bộ toàn hệ thống.");
            await OnClassCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            showConfirmNewClassModal = false;
            await OnError.InvokeAsync(ValidationRules.ErrorMessage(ex));
        }
    }
}
