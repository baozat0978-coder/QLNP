@inject AppSession Session
@inject LeaveRepository Repository
@inject NotifyService Notify

<div class="catalog-grid" style="grid-template-columns: 1fr;">
    <section class="panel">
        <div class="panel-head"><h2>Lịch nghỉ lễ / Tết</h2></div>
        <div class="catalog-form">
            <div class="field span-2"><label>Tên đợt nghỉ</label><input @bind="hName" maxlength="300" placeholder="Ví dụ: Nghỉ lễ Quốc khánh 2-9" /></div>
            <div class="field"><label>Từ ngày</label><input type="date" @bind="hFrom" @bind:format="yyyy-MM-dd" /></div>
            <div class="field"><label>Đến ngày</label><input type="date" @bind="hTo" @bind:format="yyyy-MM-dd" /></div>
            <div class="catalog-actions"><button class="btn primary" @onclick="AddHoliday"><Icon Name="plus" />Thêm đợt nghỉ</button></div>
        </div>
        <div class="table-scroll"><table class="leave-table">
            <thead><tr><th>ĐỢT NGHỈ</th><th>THỜI GIAN</th><th></th></tr></thead>
            <tbody>
                @foreach (var h in Paging.Slice(holidays, page, pageSize).Items)
                {
                    <tr><td>@h.Name</td><td>@h.FromDate.ToString("dd/MM/yyyy") – @h.ToDate.ToString("dd/MM/yyyy")</td><td><div class="row-actions"><button class="btn outline" @onclick="() => DeleteHoliday(h)">Xóa</button></div></td></tr>
                }
                @if (holidays.Count == 0) { <tr><td colspan="3" class="empty-table">Chưa có đợt nghỉ nào.</td></tr> }
            </tbody></table></div>
        <Pager Total="holidays.Count" @bind-Page="page" @bind-PageSize="pageSize" Label="đợt nghỉ" />
    </section>
</div>

@code {
    private List<Holiday> holidays = new();
    private int page = 1, pageSize = Paging.DefaultSize;
    private string hName = "";
    private DateTime hFrom = DateTime.Today, hTo = DateTime.Today.AddDays(2);
    protected override void OnInitialized() => Load();
    private void Load() { holidays = Repository.GetHolidays(Session); }
    private void RunH(Action work, string ok)
    {
        Notify.ClearErrors();
        try { work(); Load(); Notify.Success(ok); }
        catch (Exception ex) { Notify.Error(ValidationRules.ErrorMessage(ex)); }
    }
    private void AddHoliday()
    {
        var added = hName.Trim();
        RunH(() => { Repository.AddHoliday(Session, hName, hFrom.Date.AddHours(17), hTo.Date.AddHours(17)); hName = ""; }, $"Đã thêm đợt nghỉ \"{added}\".");
    }
    private async Task DeleteHoliday(Holiday h)
    {
        if (!await Notify.ConfirmAsync("Xóa đợt nghỉ?", $"Đợt nghỉ \"{h.Name}\" ({h.FromDate:dd/MM/yyyy} – {h.ToDate:dd/MM/yyyy}) sẽ bị xóa khỏi lịch nghỉ lễ / Tết."))
            return;
        RunH(() => Repository.DeleteHoliday(Session, h.Id), $"Đã xóa đợt nghỉ \"{h.Name}\".");
    }
}
