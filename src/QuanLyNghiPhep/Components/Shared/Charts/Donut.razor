@using System.Globalization
@{
    var total = Items.Sum(x => x.Value);
    var parts = Items.Where(x => x.Value > 0).ToList();
    var gap = parts.Count > 1 ? 0.8 : 0; // khe hở nhỏ giữa các phần
    double acc = 0;
}
<div class="donut-wrap">
    <svg viewBox="0 0 42 42" class="donut" role="img" aria-label="@CenterLabel: @total">
        <circle cx="21" cy="21" r="15.9155" fill="none" stroke="#eef2f0" stroke-width="4" />
        @if (total > 0)
        {
            @foreach (var s in parts)
            {
                var pct = 100.0 * s.Value / total;
                <circle cx="21" cy="21" r="15.9155" fill="none" stroke="@s.Color" stroke-width="4"
                        stroke-dasharray="@F(Math.Max(0, pct - gap)) @F(100 - Math.Max(0, pct - gap))" stroke-dashoffset="@F(25 - acc)">
                    <title>@s.Label: @s.Value</title>
                </circle>
                acc += pct;
            }
        }
        <text x="21" y="21.6" text-anchor="middle" class="donut-num">@total</text>
        <text x="21" y="26" text-anchor="middle" class="donut-lbl">@CenterLabel</text>
    </svg>
    <ul class="legend">
        @foreach (var s in Items)
        {
            <li><i style="background:@s.Color"></i><span>@s.Label</span><b>@s.Value</b><em>@(total == 0 ? 0 : (int)Math.Round(100.0 * s.Value / total))%</em></li>
        }
    </ul>
</div>
@code {
    [Parameter, EditorRequired] public List<Slice> Items { get; set; } = new();
    [Parameter] public string CenterLabel { get; set; } = "";
    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
}
